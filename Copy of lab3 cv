import cv2
import numpy as np
import matplotlib.pyplot as plt


def show_comparison(*images_with_titles):
    """Displays multiple images with their titles for comparison."""
    num_images = len(images_with_titles)
    if num_images == 0:
        print("No images provided for comparison.")
        return

    fig, axes = plt.subplots(1, num_images, figsize=(5 * num_images, 5))
    if num_images == 1:
        axes = [axes] # Ensure axes is iterable even for a single image

    for i, (image, title) in enumerate(images_with_titles):
        axes[i].imshow(image, cmap='gray')
        axes[i].set_title(title)
        axes[i].axis('off')
    plt.tight_layout()
    plt.show()


image_path = '/content/drive/MyDrive/tiger'



original_image = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)

if original_image is None:
    print(f"Error: Image at '{image_path}' not found or could not be loaded. Please check the path and make sure it's a valid image file.")
else:
    print(f"Image '{image_path}' loaded successfully.")

    blur_3 = cv2.GaussianBlur(original_image, (3, 3), 0)
    blur_5 = cv2.GaussianBlur(original_image, (5, 5), 0)
    blur_7 = cv2.GaussianBlur(original_image, (7, 7), 0)
    blur_11= cv2.GaussianBlur(original_image, (11, 11), 0)


    show_comparison(
        (original_image, 'Original Image'),
        (blur_3, 'Gaussian Blur (kernel 3x3)'),
        (blur_5, 'Gaussian Blur (kernel 5x5)'),
        (blur_7, 'Gaussian Blur (kernel 7x7)'),
        (blur_11, 'Gaussian Blur (kernel 11x11)')
    )
